@* Vista de inicio de sesión. Envía usuario y contraseña al AccountController. *@

@{Layout=null;}
<!doctype html><html><head><meta charset="utf-8"/><link rel="stylesheet" href="~/css/site.css"/></head>
<body><main class="container" style="max-width:420px">
<h2>Ingreso al sistema</h2>
@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}
<form method="post">
<label>Usuario</label><input name="usuario" required/>
<label>Contraseña</label><input type="password" name="password" required/>
<button>Ingresar</button>
</form>
<p><a asp-action="Facial">Ingreso facial (módulo de integración)</a></p>
</main></body></html>
